# ==================== Core API Keys (Required) ====================
ANTHROPIC_API_KEY=your_anthropic_key_here
TAVILY_API_KEY=your_tavily_key_here
GITHUB_TOKEN=your_github_token_here

# ==================== Phase 5: Academic Research (Optional) ====================
# SerpAPI - For Google Scholar access ($50/month for 5,000 searches)
# Sign up: https://serpapi.com/
SERPAPI_KEY=

# ==================== Phase 5: Community Intelligence (Optional) ====================
# Reddit OAuth - Free with Reddit app registration
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API - Free 10,000 quota/day
# Get key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# USPTO Patent API - Free, optional
USPTO_API_KEY=

# ==================== Phase 5: Integrations (Optional) ====================
# Slack - For notifications
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# SendGrid - For email digests ($15/month for 40k emails)
SENDGRID_API_KEY=
EMAIL_FROM=research@agent.com

# Notion - For exporting research (Free for personal use)
# Get key: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ==================== Database (Production) ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_agent
REDIS_URL=redis://localhost:6379

# ==================== Settings ====================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== Phase 5B: Enterprise Features (Disabled by default) ====================
ENABLE_AUTHENTICATION=false
ENABLE_RATE_LIMITING=false
ENABLE_ANALYTICS=true
ENABLE_MULTI_TENANT=false

# ==================== Phase 5A: Personal Features ====================
ENABLE_ACADEMIC_WORKER=true
ENABLE_REDDIT_WORKER=true
ENABLE_YOUTUBE_WORKER=true
ENABLE_PATENT_WORKER=true
ENABLE_FOLLOWUP_CHAT=true
ENABLE_VISUALIZATIONS=true
ENABLE_PDF_EXPORT=true
ENABLE_PERSONALIZATION=true
